{
  "features": {
    "handovers": true,
    "issues": true,
    "reviews": true,
    "roadmap": true,
    "tickets": true
  },
  "language": "kotlin",
  "project": "Sift",
  "schemaVersion": 2,
  "type": "gradle",
  "version": 2,
  "recipeOverrides": {
    "maxTicketsPerSession": 0,
    "reviewBackends": [
      "lenses",
      "agent"
    ],
    "codexReviewBackends": [
      "lenses"
    ],
    "handoverInterval": 3,
    "stages": {
      "TEST": {
        "enabled": true
      },
      "WRITE_TESTS": {
        "enabled": true,
        "onExhaustion": "plan"
      }
    }
  }
}
